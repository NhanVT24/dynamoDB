{
  "name": "supermarket-shopping-dynamodb",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n WEB,API -c cyan,green \"npm run dev -w @supermarket/web\" \"npm run dev -w @supermarket/api\"",
    "dev:web": "npm run dev -w @supermarket/web",
    "dev:api": "npm run dev -w @supermarket/api",
    "build": "npm run build --workspaces",
    "build:lambda": "npm run package:lambda -w @supermarket/api",
    "cdk:aws:bootstrap": "cdk bootstrap --app \"npx ts-node --project infra/tsconfig.json infra/bin/aws-api.ts\"",
    "cdk:aws:synth": "npm run build:lambda && cdk synth --app \"npx ts-node --project infra/tsconfig.json infra/bin/aws-api.ts\"",
    "cdk:aws:deploy": "npm run build:lambda && cdk deploy --app \"npx ts-node --project infra/tsconfig.json infra/bin/aws-api.ts\" --require-approval never",
    "deploy:aws": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\deploy-aws.ps1",
    "cdk:aws:destroy": "cdk destroy --app \"npx ts-node --project infra/tsconfig.json infra/bin/aws-api.ts\" --force",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:init": "npm run db:init -w @supermarket/api",
    "db:seed": "npm run db:seed -w @supermarket/api",
    "db:localize": "npm run db:localize -w @supermarket/api",
    "mail:test:weekly-report": "npm run mail:test:weekly-report -w @supermarket/api"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "aws-cdk": "^2.1135.1",
    "aws-cdk-lib": "^2.220.0",
    "concurrently": "^9.2.0",
    "constructs": "^10.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/client-sqs": "^3.1095.0",
    "@fastify/aws-lambda": "^6.4.0",
    "async-mutex": "^0.5.0"
  }
}
