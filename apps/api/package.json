{
  "name": "@supermarket/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:ts && node scripts/package-lambda.js",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package:lambda": "npm run build:ts && node scripts/package-lambda.js",
    "db:init": "tsx src/scripts/create-table.ts",
    "db:reset-table": "tsx src/scripts/reset-table.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:test": "tsx src/scripts/seed.ts --products=2000 --include-orders --customers=120 --orders-per-customer=12",
    "db:reseed": "tsx src/scripts/reseed.ts",
    "db:backfill-products": "tsx src/scripts/backfill-products.ts",
    "db:update-product-images": "tsx src/scripts/update-product-images.ts",
    "db:localize": "tsx src/scripts/localize-products.ts",
    "mail:test:status": "tsx src/scripts/test-payment-status-emails.ts",
    "mail:test:weekly-report": "tsx src/scripts/send-weekly-admin-report-preview.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1095.0",
    "@aws-sdk/client-eventbridge": "3.1095.0",
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/client-scheduler": "3.1095.0",
    "@aws-sdk/client-sesv2": "3.1095.0",
    "@aws-sdk/client-sns": "3.1095.0",
    "@aws-sdk/client-sqs": "3.1095.0",
    "@aws-sdk/core": "3.977.6",
    "@aws-sdk/lib-dynamodb": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@aws-sdk/util-dynamodb": "3.996.7",
    "@fastify/aws-lambda": "^6.4.0",
    "@fastify/cors": "^11.0.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.0",
    "fastify": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.5"
  },
  "overrides": {
    "@aws-sdk/core": "3.977.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
