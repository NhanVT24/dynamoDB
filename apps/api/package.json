{
  "name": "@supermarket/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "node --check src/server.js && node --check src/lambda.js && node --check scripts/package-lambda.js",
    "start": "node src/server.js",
    "typecheck": "node --check src/server.js && node --check src/lambda.js",
    "package:lambda": "node scripts/package-lambda.js",
    "db:init": "node src/scripts/create-table.js",
    "db:reset-table": "node src/scripts/reset-table.js",
    "db:seed": "node src/scripts/seed.js",
    "db:reseed": "node src/scripts/reseed.js",
    "db:localize": "node src/scripts/localize-products.js",
    "db:test-begins-with-name": "node src/scripts/test-begins-with-name.js",
    "db:view-raw": "node src/scripts/view-raw-data.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.850.0",
    "@aws-sdk/lib-dynamodb": "^3.850.0",
    "@aws-sdk/util-dynamodb": "^3.996.7",
    "@fastify/aws-lambda": "^6.4.0",
    "@fastify/cors": "^11.0.1",
    "dotenv": "^17.2.0",
    "fastify": "^5.4.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {}
}
