# Tham khảo tổng hợp. Khi chạy local, hãy copy các file .env mẫu trong từng app
# theo hướng dẫn README.
#
# Backend
PORT=4000
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_NAME=StudentManagement

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
